# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# =============================================================================
# Email (IMAP - for receiving)
# =============================================================================
# For Proton Mail: Use Proton Bridge (must be running). Default ports:
#   IMAP: localhost:1143, SMTP: localhost:1025
# For other providers: Use their IMAP/SMTP server addresses.
# =============================================================================
IMAP_HOST=127.0.0.1
IMAP_PORT=1143
IMAP_USER=you@youremail.io
# IMAP password:
# - For local dev: set IMAP_PASSWORD
# - For EC2: leave blank and set AWS Secrets Manager vars below
IMAP_PASSWORD=

# Proton Bridge uses a self-signed cert; set to 1 if you get SSL errors
# IMAP_SSL_SKIP_VERIFY=1

# =============================================================================
# Email (SMTP - for sending)
# =============================================================================
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=you@youremail.io
# SMTP password:
# - For local dev: set SMTP_PASSWORD
# - For EC2: leave blank and set AWS Secrets Manager vars below
SMTP_PASSWORD=

# Proton Bridge: set to 1 if you get SSL errors
# SMTP_SSL_SKIP_VERIFY=1

# =============================================================================
# LLM API (Claude / Anthropic)
# =============================================================================
# Get an API key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Anthropic API key:
# - For local dev: set ANTHROPIC_API_KEY
# - For EC2: leave blank and set AWS Secrets Manager vars below

# Optional: Model to use (default: claude-haiku-4-5 for cost efficiency)
# ANTHROPIC_MODEL=claude-haiku-4-5

# =============================================================================
# Customization
# =============================================================================
# Email signoff: appended to every email you send. Use signoff.txt for multi-line
# (copy from signoff.example.txt) or set here; use \n for newline.
# EMAIL_SIGNOFF=Best,\nBen

# Optional: path to feedback JSON file (default: feedback.json in project root)
# FEEDBACK_FILE=./feedback.json

# =============================================================================
# AWS Secrets Manager (optional, recommended for EC2)
# =============================================================================
# When enabled, IMAP_PASSWORD, SMTP_PASSWORD, and ANTHROPIC_API_KEY are fetched
# from AWS Secrets Manager instead of this .env file.
#
# You stored secrets as:
#   email-agent/imap-password
#   email-agent/smtp-password
#   email-agent/anthropic-api-key
#
# Requires the instance IAM role to allow:
#   secretsmanager:GetSecretValue for those secrets.
AWS_SECRETS_MANAGER_ENABLED=1
AWS_SECRETS_MANAGER_REGION=us-east-2
AWS_SECRET_IMAP_PASSWORD_ID=email-agent/imap-password
AWS_SECRET_SMTP_PASSWORD_ID=email-agent/smtp-password
AWS_SECRET_ANTHROPIC_API_KEY_ID=email-agent/anthropic-api-key

# =============================================================================
# Calendar digest (optional)
# =============================================================================
# Calendar allowlist and schedule live locally (recommended):
#   - calendar_allowlist.txt (copy from calendar_allowlist.example.txt)
#   - calendar_schedule.txt (copy from calendar_schedule.example.txt)
#
# Or set via env vars:
# CALENDAR_ALLOWLIST=friend@example.com,recruiter@company.com
# CALENDAR_SCHEDULE=18:00 daily;10:00 sat
#
# Optional: state file for tracking last digest per schedule (default: calendar_state.json)
# CALENDAR_STATE_FILE=./calendar_state.json
